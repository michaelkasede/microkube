# Ansible inventory generated by Terraform — do not edit by hand.
# Regenerated on every `terraform apply`.

[masters]
%{ for name, node in nodes ~}
%{ if node.role == "master" ~}
${name} ansible_host=${node.ip}
%{ endif ~}
%{ endfor ~}

[workers]
%{ for name, node in nodes ~}
%{ if node.role == "worker" ~}
${name} ansible_host=${node.ip}
%{ endif ~}
%{ endfor ~}

[microkube:children]
masters
workers

[microkube:vars]
ansible_user=${ssh_user}
ansible_python_interpreter=/usr/bin/python3
